# ─── Frontend (Next.js dashboard) environment ──────────────────────────────
# Copy to .env.local for local dev, OR set these in the Vercel project
# Settings → Environment Variables for the hosted deploy.

# Supabase Postgres connection — MUST use the Transaction Pooler host
# (e.g. aws-0-<region>.pooler.supabase.com:6543). The direct db.<ref>...
# host is IPv6-only and times out from Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ─── Interim access gate (see middleware.ts) ───────────────────────────────
# DASHBOARD_PASSWORD : the shared password HR types on /login
# DASHBOARD_AUTH_TOKEN: a long random secret — the value stored in the
#                       auth cookie. Generate once, keep stable. Example:
#                       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If DASHBOARD_AUTH_TOKEN is UNSET, the gate is disabled (handy for local
# dev). ALWAYS set both in the Vercel project so the hosted site is gated.
DASHBOARD_PASSWORD=change-me-to-a-team-password
DASHBOARD_AUTH_TOKEN=REPLACE_WITH_64_CHAR_RANDOM_HEX
